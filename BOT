class Task:
    def __init__(self, title):
        self.title = title
        #self.done = False

    def __repr__(self):
        return self.title

    def __str__(self):
        return self.title

class TaskManager:
    def __init__(self):
        self.tasks = []

    def addTask(self, title):
        task = Task(title)
        self.tasks.append(task)
        return f"Task {task} added successfully"

    def removeTask(self, title):
        title = title.strip().lower()

        for task in self.tasks:
            if task.title.strip().lower() == title:
                self.tasks.remove(task)
                print(f"Task {title} removed successfully")
                return


    def viewTasks(self):
        if len(self.tasks) == 0:
            return "No tasks added, list is empty"
        else:
            print("Your to-do list is: ")
            return f"{self.tasks}"

class Bot(TaskManager):
    def __init__(self, name, patterns=None, default_reply="I cannot answer for now."):
        super().__init__()
        self.name = name
        self.patterns = patterns or {}
        self.default_reply = default_reply

    def normalize(self, text: str) -> str:
        return text.lower().strip()

    def get_reply(self, user_message: str) -> str:
        normalized = self.normalize(user_message)        # calling func normalize on what user inputs

        for pattern, answer in self.patterns.items():
            if pattern in normalized:
                return answer.format(name=self.name)     # searching key(pattern) = answer in dict

    def sayHi(self):
        return f"{self.name} says hi, Im a taskmanager bot, how can i help you?"



